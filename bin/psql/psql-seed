#! /usr/bin/bash

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="psql-seed"
printf "${CYAN}==${LABEL}${NO_COLOR}\n"

seed_path="$(realpath .)/bin/db/sql/seed.sql"

echo $seed_path


if [ "$1" = "prod" ]; then
	echo "Running in Production Mode"
	SEED_URL=$PROD_CONNECTION_URL
else

	DB_URL=$(sed 's/\db/localhost/g' <<<"$PSQL_DB_URL")
	SEED_URL=$DB_URL
fi

psql $SEED_URL cruddur < $seed_path