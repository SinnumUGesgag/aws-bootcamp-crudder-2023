#! /usr/bin/bash

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="psql-create"
printf "${CYAN}==${LABEL}${NO_COLOR}\n"

echo "psql-create"

if [ "$1" = "prod" ]; then
	echo "Running in Production Mode"
	CON_URL=$PROD_CONNECTION_URL
else

    DB_URL=$(sed 's/\db/localhost/g' <<<"$PSQL_DB_URL")
    CON_URL=$(sed 's/\/cruddur//g' <<< "$DB_URL")
fi

psql $CON_URL -c "create database cruddur;"

