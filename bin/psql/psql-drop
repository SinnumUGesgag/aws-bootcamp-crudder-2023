#! /usr/bin/bash

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="psql-drop"
printf "${CYAN}==${LABEL}${NO_COLOR}\n"

echo "psql-drop"

if [ "$1" = "prod" ]; then
	echo "Running in Production Mode"
	CON_URL=$PROD_CONNECTION_URL
else

    DB_URL=$(sed 's/\db/localhost/g' <<<"$PSQL_CRUDDUR_DB_URL") # I have to remove db then replace it with localhost, since Bash commands are being executed into the PostgreSQL; yet Backend-Flask needs to look at the Service Name when it follows the URL to find it's path to the PostgreSQL Container
    CON_URL=$(sed 's/\/cruddur//g' <<< "$DB_URL")
fi

psql $CON_URL -c "drop database cruddur;"