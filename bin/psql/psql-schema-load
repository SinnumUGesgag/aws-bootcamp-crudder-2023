#! /usr/bin/bash

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="psql-schema-load"
printf "${CYAN}==${LABEL}${NO_COLOR}\n"

schema_path="$(realpath .)/bin/db/sql/schema.sql"

echo "psql-schema-load"

#psql $PSQL_DB_URL cruddur < $schema_path


if [ "$1" = "prod" ]; then
	echo "Running in Production Mode"
	CON_URL=$PROD_CONNECTION_URL
else
	DB_URL=$(sed 's/\db/localhost/g' <<<"$PSQL_DB_URL")
	CON_URL=$DB_URL
fi

psql $CON_URL cruddur < $schema_path
