// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-docker-compose
{
	// "name": "CRUDDUR Configuration in Codespaces",
	"image": "mcr.microsoft.com/devcontainers/base:jammy",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"features": {
		"ghcr.io/devcontainers/features/aws-cli:1": {},
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers-extra/features/bash-command:1": {},
		"ghcr.io/devcontainers-extra/features/node-asdf:0": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"containerEnv": {
		"AWS_CLI_AUTO_PROMPT": "on-partial",
		"AWS_ACCESS_KEY_ID": "${localEnv:AWS_ACCESS_KEY_ID}",
		"AWS_ACCOUNT_ID": "${localEnv:AWS_ACCOUNT_ID}",
		"AWS_COGNITO_DOMAIN": "${localEnv:AWS_COGNITO_DOMAIN}",
		"AWS_COGNITO_REDIRECT_URL": "${localEnv:AWS_COGNITO_REDIRECT_URL}",
		"AWS_DEFAULT_REGION": "${localEnv:AWS_DEFAULT_REGION}",
		"AWS_LOCAL_DYDB_ENDPOINT_URL": "${localEnv:AWS_LOCAL_DYDB_ENDPOINT_URL}",
		"AWS_SECRET_ACCESS_KEY": "${localEnv:AWS_SECRET_ACCESS_KEY}",
		"HONEYCOMB_API_KEY": "${localEnv:HONEYCOMB_API_KEY}",
		"MY_COGNITO_CLIENT_ID": "${localEnv:MY_COGNITO_CLIENT_ID}",
		"MY_COGNITO_USER_POOL_ID": "${localEnv:MY_COGNITO_USER_POOL_ID}",
		"PROD_CONNECTION_URL": "${localEnv:PROD_CONNECTION_URL}",
		"PSQL_CRUDDUR_DB_URL": "${localEnv:PSQL_CRUDDUR_DB_URL}",
		"RDS_POSTGRESQL_SG_ID": "${localEnv:RDS_POSTGRESQL_SG_ID}",
		"RDS_POSTGRESQL_SG_RULE_ID": "${localEnv:RDS_POSTGRESQL_SG_RULE_ID}",
		"ROLLBAR_ACCESS_TOKEN": "${localEnv:ROLLBAR_ACCESS_TOKEN}",
		"ECR_PYTHON_URL": "${localEnv:ECR_PYTHON_URL}",
		"ECR_BACKEND_FLASK_URL": "${localEnv:ECR_BACKEND_FLASK_URL}",
		"ECR_FRONTEND_REACT_URL": "${localEnv:ECR_FRONTEND_REACT_URL}",
		"CRUDDUR_DOMAIN_NAME": "${localEnv:CRUDDUR_DOMAIN_NAME}",
		"ASSETS_BUCKET_NAME":"${localEnv:CRUDDUR_UUID}.assets.${localEnv:CRUDDUR_DOMAIN_NAME}",
		"PERSCOMMS_BUCKET_NAME":"${localEnv:CRUDDUR_UUID}.convo.${localEnv:CRUDDUR_DOMAIN_NAME}",
		"POSTS_BUCKET_NAME":"${localEnv:CRUDDUR_UUID}.posts.${localEnv:CRUDDUR_DOMAIN_NAME}",
		"THUMBING_S3_FOLDER_INPUT": "${localEnv:CRUDDUR_UUID}/avatar/original",
		"THUMBING_S3_FOLDER_OUTPUT": "${localEnv:CRUDDUR_UUID}/avatar/processed",
		"THUMBING_WEBHOOK_URL": "https://api.${localEnv:CRUDDUR_DOMAIN_NAME}/${localEnv:CRUDDUR_UUID}/webhooks/avatar",
		"THUMBING_TOPIC_NAME": "cruddur-assets",
		"THUMBING_FUNCTION_PATH": "/workspaces/aws-bootcamp-crudder-2023/aws/lambdas/process-images",
		"ARN__AWS_ACCESS_KEY_ID": "arn:aws:ssm:${localEnv:AWS_DEFAULT_REGION}:${localEnv:AWS_ACCOUNT_ID}:parameter/cruddur/app/backend-flask/${localEnv:AWS_ACCESS_KEY_ID}",
		"ARN__AWS_SECRET_ACCESS_KEY": "arn:aws:ssm:${localEnv:AWS_DEFAULT_REGION}:${localEnv:AWS_ACCOUNT_ID}:parameter/cruddur/app/backend-flask/${localEnv:AWS_SECRET_ACCESS_KEY}",
		"ARN__PSQL_CRUDDUR_DB_URL": "arn:aws:ssm:${localEnv:AWS_DEFAULT_REGION}:${localEnv:AWS_ACCOUNT_ID}:parameter/cruddur/app/backend-flask/${localEnv:PSQL_CRUDDUR_DB_URL}",
		"ARN__ROLLBAR_ACCESS_TOKEN": "arn:aws:ssm:${localEnv:AWS_DEFAULT_REGION}:${localEnv:AWS_ACCOUNT_ID}:parameter/cruddur/app/backend-flask/${localEnv:ROLLBAR_ACCESS_TOKEN}",
		"ARN__OTEL_EXPORTER_OTLP_HEADERS": "arn:aws:ssm:${localEnv:AWS_DEFAULT_REGION}:${localEnv:AWS_ACCOUNT_ID}:parameter/cruddur/app/backend-flask/${localEnv:OTEL_EXPORTER_OTLP_HEADERS}",
		"ARN__BACKEND_FLASK_IMAGE": "${localEnv:AWS_ACCOUNT_ID}.dkr.ecr.us-east-2.amazonaws.com/backend-flask",
		"ARN__FRONTEND_REACT_JS_IMAGE": "${localEnv:AWS_ACCOUNT_ID}.dkr.ecr.us-east-2.amazonaws.com/frontend-react-js",
		"ARN__EXECUTIONROLEARN": "arn:aws:iam::${localEnv:AWS_ACCOUNT_ID}:role/CruddurServiceExecutionRole",
		"ARN__TASKROLEARN": "arn:aws:iam::${localEnv:AWS_ACCOUNT_ID}:role/CruddurTaskRole",
		"ARN__FRONTEND_TARGETGROUPARN": "arn:aws:elasticloadbalancing:${localEnv:AWS_DEFAULT_REGION}:${localEnv:AWS_ACCOUNT_ID}:targetgroup/cruddur-frontend-react-js-trg/a4301713d8c33b1f",
        "ARN__BACKEND_TARGETGROUPARN": "arn:aws:elasticloadbalancing:${localEnv:AWS_DEFAULT_REGION}:${localEnv:AWS_ACCOUNT_ID}:targetgroup/cruddur-backend-flask-tg/8fefa9d4333c1e0e",
		"DYNAMODB_URL": "http://dynamodb.${localEnv:AWS_DEFAULT_REGION}.amazonaws.com",
		"DOCKER_SLIMBUSTER": "${localEnv:AWS_ACCOUNT_ID}.dkr.ecr.${localEnv:AWS_DEFAULT_REGION}.amazonaws.com/cruddur-python:3.10-slim-buster",
		"AWS_SECURITYGROUP": "sg-04c2f931adb37f269",
		"AWS_SG_SUBNET_1": "subnet-07b014a09b1219a92",
		"AWS_SG_SUBNET_2": "subnet-02625ce277f20029b",
		"AWS_SG_SUBNET_3": "subnet-0acd25acbbaaf9c11",
		"REACT_APP_BACKEND_URL": "${localEnv:ECR_BACKEND_FLASK_URL}",
		"REACT_APP_AWS_PROJECT_REGION": "${localEnv:AWS_DEFAULT_REGION}",
		"REACT_APP_AWS_COGNITO_REGION": "${localEnv:AWS_DEFAULT_REGION}",
		"REACT_APP_AWS_USER_POOLS_ID": "${localEnv:MY_COGNITO_USER_POOL_ID}",
		"REACT_APP_CLIENT_ID": "${localEnv:MY_COGNITO_CLIENT_ID}"
		

	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"ms-azuretools.vscode-containers",
				"cweijan.dbclient-jdbc",
				"cweijan.vscode-mysql-client2",
				"ms-python.vscode-pylance",
				"ms-python.python",
				"ms-python.debugpy",
				"ms-python.vscode-python-envs",
				"redhat.vscode-yaml",
				"dsznajder.es7-react-js-snippets"
			]
		}
	},
	"postCreateCommand": "bash .devcontainer/post_Create_CommandS.sh",
	"forwardPorts": [3000, 4567, 5432, 8000],
	"portsAttributes": {
    	"3000": {
			"label": "FRONTEND-React-JS"
		},
		"4567": {
			"label": "BACKEND-Flask"
		},
		"5432": {
			"label": "PostgreSQL"
		},
		"8000": {
			"label": "Dynamodb-Local"
		}
    },
	"postStartCommand": "bash .devcontainer/post_Start_Command.sh"
}