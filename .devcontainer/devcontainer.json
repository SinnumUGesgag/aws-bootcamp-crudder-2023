// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-docker-compose
{
	// "name": "CRUDDUR Configuration in Codespaces",
	"image": "mcr.microsoft.com/devcontainers/base:jammy",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"features": {
		"ghcr.io/devcontainers/features/aws-cli:1": {},
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers-extra/features/bash-command:1": {},
		"ghcr.io/devcontainers-extra/features/node-asdf:0": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"containerEnv": {
		"AWS_CLI_AUTO_PROMPT": "on-partial",
		"AWS_ACCESS_KEY_ID": "${localEnv:AWS_ACCESS_KEY_ID}",
		"AWS_ACCOUNT_ID": "${localEnv:AWS_ACCOUNT_ID}",
		"AWS_COGNITO_DOMAIN": "${localEnv:AWS_COGNITO_DOMAIN}",
		"AWS_COGNITO_REDIRECT_URL": "${localEnv:AWS_COGNITO_REDIRECT_URL}",
		"AWS_DEFAULT_REGION": "${localEnv:AWS_DEFAULT_REGION}",
		"AWS_LOCAL_DYDB_ENDPOINT_URL": "${localEnv:AWS_LOCAL_DYDB_ENDPOINT_URL}",
		"AWS_SECRET_ACCESS_KEY": "${localEnv:AWS_SECRET_ACCESS_KEY}",
		"HONEYCOMB_API_KEY": "${localEnv:HONEYCOMB_API_KEY}",
		"MY_COGNITO_CLIENT_ID": "${localEnv:MY_COGNITO_CLIENT_ID}",
		"MY_COGNITO_USER_POOL_ID": "${localEnv:MY_COGNITO_USER_POOL_ID}",
		"PROD_CONNECTION_URL": "${localEnv:PROD_CONNECTION_URL}",
		"PSQL_CRUDDUR_DB_URL": "${localEnv:PSQL_CRUDDUR_DB_URL}",
		"RDS_POSTGRESQL_SG_ID": "${localEnv:RDS_POSTGRESQL_SG_ID}",
		"RDS_POSTGRESQL_SG_RULE_ID": "${localEnv:RDS_POSTGRESQL_SG_RULE_ID}",
		"ROLLBAR_ACCESS_TOKEN": "${localEnv:ROLLBAR_ACCESS_TOKEN}",
		"ECR_PYTHON_URL": "${localEnv:ECR_PYTHON_URL}",
		"ECR_BACKEND_FLASK_URL": "${localEnv:ECR_BACKEND_FLASK_URL}",
		"ECR_FRONTEND_REACT_URL": "${localEnv:ECR_FRONTEND_REACT_URL}"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"ms-azuretools.vscode-containers",
				"cweijan.dbclient-jdbc",
				"cweijan.vscode-mysql-client2",
				"ms-python.vscode-pylance",
				"ms-python.python",
				"ms-python.debugpy",
				"ms-python.vscode-python-envs",
				"redhat.vscode-yaml",
				"dsznajder.es7-react-js-snippets"
			]
		}
	},
	"postCreateCommand": "bash .devcontainer/post_Create_CommandS.sh",
	"forwardPorts": [3000, 4567, 5432, 8000],
	"portsAttributes": {
    	"3000": {
			"label": "FRONTEND-React-JS"
		},
		"4567": {
			"label": "BACKEND-Flask"
		},
		"5432": {
			"label": "PostgreSQL"
		},
		"8000": {
			"label": "Dynamodb-Local"
		}
    },
	"postStartCommand": "bash .devcontainer/post_Start_Command.sh"
}