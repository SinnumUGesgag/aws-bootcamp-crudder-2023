FROM node:16.18 AS build

ARG ECR_BACKEND_FLASK_URL
ARG AWS_DEFAULT_REGION
ARG MY_COGNITO_USER_POOL_ID
ARG MY_COGNITO_CLIENT_ID

ENV REACT_APP_BACKEND_URL=$ECR_BACKEND_FLASK_URL
ENV REACT_APP_AWS_PROJECT_REGION=$AWS_DEFAULT_REGION
ENV REACT_APP_AWS_COGNITO_REGION=$AWS_DEFAULT_REGION
ENV REACT_APP_AWS_USER_POOLS_ID=$MY_COGNITO_USER_POOL_ID
ENV REACT_APP_CLIENT_ID=$MY_COGNITO_CLIENT_ID


COPY . ./frontend-react-js
WORKDIR /frontend-react-js
RUN npm install
RUN npm run build

FROM nginx:1.23.3-alpine

COPY --from=build /frontend-react-js/build /usr/share/nginx/html
COPY --from=build /frontend-react-js/nginx.conf /etc/nginx/nginx.conf

EXPOSE 3000

