#! /usr/bin/bash

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="rds-upgrade-sg-rule"
printf "${CYAN}==${LABEL}${NO_COLOR}\n"

export CODESPACE_IP=$(curl -s https://ipinfo.io/ip)

aws ec2 modify-security-group-rules \
    --group-id $RDS_POSTGRESQL_SG_ID \
    --security-group-rules "SecurityGroupRuleId=$RDS_POSTGRESQL_SG_RULE_ID,SecurityGroupRule={Description=CRUDDUR_CODESPACES,IpProtocol=tcp,FromPort=5432,ToPort=5432,CidrIpv4=$CODESPACE_IP/32}"
